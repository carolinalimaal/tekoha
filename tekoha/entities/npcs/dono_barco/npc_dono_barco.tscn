[sub_resource type="Resource" id="Resource_u6lot"]
script = ExtResource("2_1euh0")
actor_name = "Pescador"
text_pt = "Como eu prometi pra ti, vou te levar pra perto da tua casa."
metadata/_custom_type_script = "uid://x6215xlpsejj"

