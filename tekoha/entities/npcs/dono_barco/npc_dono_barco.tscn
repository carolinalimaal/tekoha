[sub_resource type="Resource" id="Resource_1euh0"]
script = ExtResource("2_1euh0")
actor_name = "Curupira"
text_pt = "Tu es o dono desse barco?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_cl38t"]
script = ExtResource("2_1euh0")
actor_name = "Pescador"
text_pt = "Sim, tu es o Curupira, nao e?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_grtgn"]
script = ExtResource("2_1euh0")
actor_name = "Curupira"
text_pt = "Sim... E eu estou precisando voltar pra minha cabana, mas preciso passar por esse rio"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_ff8i3"]
script = ExtResource("2_1euh0")
actor_name = "Curupira"
text_pt = "Tu podes me ajudar a atravessar esse rio?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_7di1m"]
script = ExtResource("2_1euh0")
actor_name = "Pescador"
text_pt = "Ó, eu te levo, mas vais ter que me ajudar. Preciso arrumar uma coisa no motor do barco e as ferramentas tão na casa azul."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_ninet"]
script = ExtResource("2_1euh0")
actor_name = "Pescador"
text_pt = "Se tu pegares pra mim, arrumo o barco. So tem um detalhe, a casa ta infestada com essas coisas que surgiram aqui na vila."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_6jbsf"]
script = ExtResource("3_6jbsf")
dialogues = Array[ExtResource("2_1euh0")]([SubResource("Resource_1euh0"), SubResource("Resource_cl38t"), SubResource("Resource_grtgn"), SubResource("Resource_ff8i3"), SubResource("Resource_7di1m"), SubResource("Resource_ninet")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_1cplf"]
script = ExtResource("2_1euh0")
actor_name = "Pescador"
text_pt = "Pega lá as ferramentas na minha casa, é a azul"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_fnfl1"]
script = ExtResource("3_6jbsf")
dialogues = Array[ExtResource("2_1euh0")]([SubResource("Resource_1cplf")])
