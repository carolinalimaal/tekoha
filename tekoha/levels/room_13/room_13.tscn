[sub_resource type="Resource" id="Resource_1euh0"]
script = ExtResource("13_11rqf")
actor_name = "Curupira"
text_pt = "Oi moço, esse barco é teu?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_cl38t"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Sim... Pera, tu és o Curupira?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_grtgn"]
script = ExtResource("13_11rqf")
actor_name = "Curupira"
text_pt = "É... sou eu. Resolvi voltar para casa passando por aqui, mas preciso atravessar o rio."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_ff8i3"]
script = ExtResource("13_11rqf")
actor_name = "Curupira"
text_pt = "Podes me ajudar?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_7di1m"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Ó, eu te levo, só tem um problema. Tenho que arrumar uma coisa no motor."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_ninet"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Minhas ferramentas tão na casa azul, se tu pegares pra mim eu te ajudo."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_n6g6m"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Só toma cuidado, a minha casa ficou infestada com essas coisas que surgiram aqui na mata."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_6jbsf"]
script = ExtResource("12_n6g6m")
dialogues = Array[ExtResource("13_11rqf")]([SubResource("Resource_1euh0"), SubResource("Resource_cl38t"), SubResource("Resource_grtgn"), SubResource("Resource_ff8i3"), SubResource("Resource_7di1m"), SubResource("Resource_ninet"), SubResource("Resource_n6g6m")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_1cplf"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Pega lá as ferramentas na minha casa, é a azul."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_fnfl1"]
script = ExtResource("12_n6g6m")
dialogues = Array[ExtResource("13_11rqf")]([SubResource("Resource_1cplf")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_u6lot"]
script = ExtResource("13_11rqf")
actor_name = "Pescador"
text_pt = "Como eu te prometi, vou te levar pra perto da tua casa."
metadata/_custom_type_script = "uid://x6215xlpsejj"

