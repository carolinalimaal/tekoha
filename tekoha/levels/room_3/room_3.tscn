[sub_resource type="Resource" id="Resource_46t15"]
script = ExtResource("20_keg0k")
actor_name = "Curupira"
text_pt = "Preciso praticar o que a Iara me ensinou antes de ir visitar os moradores da ilha!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_keg0k"]
script = ExtResource("15_4iyy6")
dialogues = Array[ExtResource("20_keg0k")]([SubResource("Resource_46t15")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_train0"]
script = ExtResource("20_keg0k")
background_image = ExtResource("17_24hp8")
text_pt = "Curupira passou alguns dias sob os ensinamentos da Iara para aprender técnicas básicas de combate com sua lança."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="DialogueSettings_train0"]
script = ExtResource("15_4iyy6")
dialogues = Array[ExtResource("20_keg0k")]([SubResource("Resource_train0")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_1r253"]
script = ExtResource("20_keg0k")
background_image = ExtResource("17_24hp8")
text_pt = "Ao terminar todo o treinamento, Curupira pensou em desistir. O peso da lança em suas mãos era um fardo imensurável para sua mente."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_5oew8"]
script = ExtResource("20_keg0k")
background_image = ExtResource("17_24hp8")
text_pt = "A responsabilidade e o dever fragilizavam a criança, que desejava apenas uma vida tranquila às margens do Rio Guamá."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_24hp8"]
script = ExtResource("20_keg0k")
actor_name = "Curupira"
background_image = ExtResource("17_24hp8")
text_pt = "Não sei se sou capaz de usar isso, Iara."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_q34pk"]
script = ExtResource("20_keg0k")
actor_name = "Iara"
background_image = ExtResource("17_24hp8")
text_pt = "Não tema, criança. A coragem que você carregará sobre os ombros não será usada para ferir, mas para amparar os indefesos."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_k68xe"]
script = ExtResource("20_keg0k")
actor_name = "Iara"
background_image = ExtResource("17_24hp8")
text_pt = "Proteja aqueles que não conseguem fazê-lo, Curupira."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_khhq5"]
script = ExtResource("20_keg0k")
actor_name = "Iara"
background_image = ExtResource("17_24hp8")
text_pt = "Vá visitar as casas e os restaurantes à beira-rio, é bom conhecer as pessoas da ilha."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_oybd7"]
script = ExtResource("15_4iyy6")
dialogues = Array[ExtResource("20_keg0k")]([SubResource("Resource_1r253"), SubResource("Resource_5oew8"), SubResource("Resource_24hp8"), SubResource("Resource_q34pk"), SubResource("Resource_k68xe"), SubResource("Resource_khhq5")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"

[sub_resource type="Resource" id="Resource_iti7q"]
script = ExtResource("20_keg0k")
actor_name = "Curupira"
text_pt = "Não posso fugir e deixar a Iara aqui!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

