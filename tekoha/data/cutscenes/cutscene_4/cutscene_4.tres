[sub_resource type="Resource" id="Resource_diml6"]
script = ExtResource("1_diml6")
actor_name = "Curupira"
background_image = ExtResource("2_hukba")
text_pt = "Iara! Iara! Você nem sabe!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_iti7q"]
script = ExtResource("1_diml6")
actor_name = "Curupira"
background_image = ExtResource("2_hukba")
text_pt = "Olha o que eu encontrei! Ela me bateu no igarapé mas eu dei uma pisa nela!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_24hp8"]
script = ExtResource("1_diml6")
actor_name = "Iara"
background_image = ExtResource("2_hukba")
text_pt = "Uma... sacola...?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_oybd7"]
script = ExtResource("1_diml6")
actor_name = "Curupira"
background_image = ExtResource("2_hukba")
text_pt = "Sim! Ela me bateu empurrando, mas eu consegui derrotá-la do jeito que você me ensinou. Era ela que estava fazendo mal aos peixes!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_1r253"]
script = ExtResource("1_diml6")
actor_name = "Iara"
background_image = ExtResource("2_hukba")
text_pt = "E essa cestinha de peixes? Você vai comer todos eles? Hmmm com uma farinha..."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_5oew8"]
script = ExtResource("1_diml6")
actor_name = "Iara"
background_image = ExtResource("3_hukba")
text_pt = "Como ele se esconde tão fácil...?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

