[sub_resource type="Resource" id="Resource_eadxp"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("2_5q6n1")
text_pt = "O Curupira é um rapaz que costuma passar seus dias de forma tranquila na Ilha do Combu. Ele pesca para se alimentar, vê as plantas crescerem e aproveita a companhia dos animais. "
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_5q6n1"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("2_5q6n1")
text_pt = "Ele frequentemente sonha com a natureza: as grandes árvores de castanha do Pará, os pássaros cantando e as aventuras que tem com os animais pela floresta."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_vx0x6"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("3_5q6n1")
text_pt = "Entretanto, recentemente, Curupira começou a ter pesadelos que o enchem de receio. "
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_k78cy"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("3_5q6n1")
text_pt = "As plantas, tão vivas quanto ele mesmo, agora estavam secas, e as árvores cortadas formavam um cenário verdadeiramente trágico nesse pesadelo. Os rios poluídos e a densa fumaça no céu acrescentavam ainda mais para o clima sombrio."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_4kn5i"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("4_k78cy")
text_pt = "Os pesadelos o assustavam tanto que ele, muitas vezes, acordava assustado..."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_b3nf8"]
script = ExtResource("1_lbqvg")
background_image = ExtResource("5_y3s2b")
text_pt = "E, com medo de tamanha maldade que via, chorava."
metadata/_custom_type_script = "uid://x6215xlpsejj"

[resource]
script = ExtResource("2_3xla2")
dialogues = Array[ExtResource("1_lbqvg")]([SubResource("Resource_eadxp"), SubResource("Resource_5q6n1"), SubResource("Resource_vx0x6"), SubResource("Resource_k78cy"), SubResource("Resource_4kn5i"), SubResource("Resource_b3nf8")])
metadata/_custom_type_script = "uid://bmi6yxeeux1kk"
