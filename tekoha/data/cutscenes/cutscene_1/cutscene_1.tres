[gd_resource type="Resource" script_class="DialogueSettings" format=3 uid="uid://bqqf1ha3k1dn8"]

[ext_resource type="Script" uid="uid://x6215xlpsejj" path="res://utils/resources/dialogue/dialogue_line.gd" id="1_lbqvg"]
[ext_resource type="Script" uid="uid://bmi6yxeeux1kk" path="res://utils/resources/dialogue/dialogue_settings.gd" id="2_3xla2"]
[ext_resource type="Texture2D" uid="uid://b5pxfstcnvmkr" path="res://data/cutscenes/cutscene_1/img_1.png" id="2_5q6n1"]
[ext_resource type="Texture2D" uid="uid://cl46tmtj7h1m0" path="res://data/cutscenes/cutscene_1/img_2.png" id="3_5q6n1"]
[ext_resource type="Texture2D" uid="uid://mwbumdcs4gr5" path="res://data/cutscenes/cutscene_1/img_3.png" id="4_k78cy"]
