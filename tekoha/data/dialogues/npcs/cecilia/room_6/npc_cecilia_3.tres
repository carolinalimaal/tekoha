[sub_resource type="Resource" id="Resource_dc3iq"]
script = ExtResource("1_2bbk3")
actor_name = "Curupira"
text_pt = "O que é isso, tia? Por que tem tantas pessoas no restaurante!?"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_bs7kn"]
script = ExtResource("1_2bbk3")
actor_name = "Cecilia"
text_pt = "Alguns deles viram você aqui mais cedo, e, curiosos, os outros quiseram confirmar se era verdade. Você está famosinho hein!"
metadata/_custom_type_script = "uid://x6215xlpsejj"

[sub_resource type="Resource" id="Resource_yd1s7"]
script = ExtResource("1_2bbk3")
actor_name = "Cecilia"
text_pt = "Vamos para a cozinha, tenho que lhe dar o que lhe prometi!"
